{% if plan.context %}
<section>
  <h2>Kontext</h2>
  <div class="plan-context">
    <div class="plan-card">
      <div class="plan-label">Problem</div>
      <p>{{ plan.context.problem }}</p>
    </div>
    <div class="plan-card">
      <div class="plan-label">Ergebnis</div>
      <p>{{ plan.context.outcome }}</p>
    </div>
  </div>
</section>
{% endif %}
