{% if plan.context %}
<section>
  <h2>Kontext</h2>
  <div class="context">
    <div class="card">
      <div class="label">Problem</div>
      <p>{{ plan.context.problem }}</p>
    </div>
    <div class="card">
      <div class="label">Ergebnis</div>
      <p>{{ plan.context.outcome }}</p>
    </div>
  </div>
</section>
{% endif %}
