<section>
  <h2>Schritte</h2>
  <ol class="steps">
    {% for step in plan.steps %}
    <li class="step">
      <h3>{{ step.title }}</h3>
      {% if step.rationale %}<p class="rationale">{{ step.rationale }}</p>{% endif %}
      <ul class="files">
        {% for file in step.files %}
        <li>
          <span class="path">{{ file.path }}</span>
          <span class="change">{{ file.change }}</span>
        </li>
        {% endfor %}
      </ul>
      {% if step.commands and step.commands | length %}
      <ul class="commands">
        {% for command in step.commands %}<li>{{ command }}</li>{% endfor %}
      </ul>
      {% endif %}
    </li>
    {% endfor %}
  </ol>
</section>
